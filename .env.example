# Environment variables template for healthcare-ai
# Copy this file to .env and adjust values for local development

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging configuration
LOG_LEVEL=INFO

# Storage paths
DATA_DIR=data/
MODEL_DIR=models/

# Experiment tracking & External APIs (optional)
# WANDB_API_KEY=
# MLFLOW_TRACKING_URI=
