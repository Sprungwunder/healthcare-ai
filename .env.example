# Environment variables template for healthcare-ai
# Copy this file to .env and adjust values for local development

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging configuration
LOG_LEVEL=INFO

# Storage paths
DATA_DIR=data/
MODEL_DIR=models/

# Experiment tracking & External APIs (optional)
# WANDB_API_KEY=
# MLFLOW_TRACKING_URI=

# Lab agent (packages/lab-agent): OpenAI or any OpenAI-compatible server
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Or Claude (python -m lab_agent --provider anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
