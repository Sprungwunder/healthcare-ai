# Document hub configuration. Copy to `.env` (same directory) and adjust.
# `.env` is gitignored; never commit real secrets.

# --- Django ---
# Required when DJANGO_DEBUG is off. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins, needed behind a proxy or on a non-default port.
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# HTTPS hardening (SSL redirect, secure cookies, HSTS). Defaults to on unless DEBUG.
# DJANGO_HTTPS=false
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_PRELOAD=false
# DJANGO_TRUST_X_FORWARDED_PROTO=false
LOG_LEVEL=INFO

# --- Database ---
# Defaults to SQLite (db.sqlite3 next to manage.py) when unset.
# DATABASE_URL=postgres://document_hub:<password>@localhost:5432/document_hub

# --- Storage ---
# MEDIA_ROOT=./media

# --- Document hub ---
# Maximum upload size in bytes (default 10 MB).
DOCUMENT_HUB_MAX_UPLOAD_SIZE=10485760
DOCUMENT_HUB_SEARCH_BACKEND=documents.search.DatabaseSearchBackend
# Password for demo users created by `manage.py seed_demo` (optional).
# DOCUMENT_HUB_DEMO_PASSWORD=

# --- docker compose only ---
# POSTGRES_PASSWORD=
# Host port for Postgres (change if 5432 is taken locally).
# POSTGRES_HOST_PORT=5432
